        &lt;Router&gt;<br>
        &nbsp;&nbsp;&lt;Routes&gt;<br>
        &nbsp;&nbsp;&nbsp;&nbsp;&lt;Route path="/login" element={&lt;Login /&gt;} /&gt;<br>
        &nbsp;&nbsp;&nbsp;&nbsp;&lt;Route path="/" element={&lt;Home /&gt;} /&gt;<br>
        &nbsp;&nbsp;&nbsp;&nbsp;&lt;Route path="/quiz" element={&lt;Quiz /&gt;} /&gt;<br>
        &nbsp;&nbsp;&nbsp;&nbsp;&lt;Route path="/goals" element={&lt;GoalTracker /&gt;} /&gt;<br>
        &nbsp;&nbsp;&lt;/Routes&gt;<br>
        &lt;/Router&gt;
        </span>
    </td>
</tr>
