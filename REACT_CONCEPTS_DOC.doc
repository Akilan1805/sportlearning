        export function useAuth() {<br>
        &nbsp;&nbsp;const context = useContext(AuthContext);<br>
        &nbsp;&nbsp;if (!context) {<br>
        &nbsp;&nbsp;&nbsp;&nbsp;throw new Error('useAuth must be used within AuthProvider');<br>
        &nbsp;&nbsp;}<br>
        &nbsp;&nbsp;return context;<br>
        }
        </span>
    </td>
</tr>
